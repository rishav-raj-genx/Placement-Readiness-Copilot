# ========================================================
# SUPABASE CONFIGURATION (Obtain from Member 1)
# ========================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=project-screenshots

# ========================================================
# SCRAPING & AUTOMATION SETTINGS
# ========================================================
HEADLESS_BROWSER=true
SCREENSHOT_DIR=data/screenshots
DEFAULT_VIEWPORT_WIDTH=375
DEFAULT_VIEWPORT_HEIGHT=812
BROWSER_TIMEOUT_MS=25000

# ========================================================
# OPTIONAL API KEYS & LIMITS
# ========================================================
MAX_JOBS_PER_SOURCE=30
AUTOMATION_E2E_MODE=false
LOG_LEVEL=INFO
